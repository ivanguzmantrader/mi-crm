# Copia este archivo a .env.local (ignorado por git) y rellena los valores.
#
# Las tres las escribe `npx convex dev` la primera vez, al crear/enlazar el
# proyecto en tu cuenta de Convex. No hace falta rellenarlas a mano.

# Deployment de DESARROLLO al que apunta la CLI de Convex.
# ⚠️ Cuidado: con esta variable presente, `npx convex deploy` (sin CONVEX_DEPLOY_KEY)
# apunta al deployment de PRODUCCIÓN del proyecto, no a este. Para el día a día
# usa `npx convex dev`.
CONVEX_DEPLOYMENT=

# URL del backend que consume el navegador. Sin ella la app muestra
# "Convex no configurado" en lugar de las pantallas.
NEXT_PUBLIC_CONVEX_URL=

# URL de HTTP actions del mismo deployment (la genera Convex; aún no se usa).
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- Solo en Railway, nunca aquí ---
# CONVEX_DEPLOY_KEY: clave de despliegue de producción (Convex → Settings →
# Deploy keys). La usa `npm run build:railway`. Ver README › Despliegue.
